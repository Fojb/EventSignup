# Copy to .env to override defaults used by docker-compose.yml (.env is git-ignored).

# SQL Server SA password: at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=EventSignup_Dev_2026!

# Groq API key for natural-language search (https://console.groq.com/keys). Optional.
GROQ_API_KEY=
